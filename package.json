{
  "name": "gdp-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GDP 等价地图：随手选一个省/州/国家，看它相当于多少个国家之和",
  "homepage": "https://rockbenben.github.io/gdp-map/",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "data": "node scripts/fetch-sources.mjs && node scripts/fetch-regions.mjs && node scripts/build-data.mjs",
    "data:fetch": "node scripts/fetch-sources.mjs",
    "data:build": "node scripts/build-data.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "acceptance": "node scripts/acceptance.mjs",
    "audit:ui": "node scripts/audit-ui.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "gifenc": "^1.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "i18n-iso-countries": "^7.14.0",
    "pinyin-pro": "^3.29.5",
    "playwright": "^1.64.1",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
